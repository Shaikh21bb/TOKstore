{
  "name": "tok-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vinext/dist/cli.js dev --port 4173",
    "build": "node --import ./scripts/sites-env.mjs ./node_modules/vinext/dist/cli.js build",
    "pages:build": "node ./scripts/build-github-pages.mjs",
    "db:generate": "drizzle-kit generate",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
